# ─────────────────────────────────────────────────────────────
#  Supabase — Kontaktanfragen
#  Werte findest du im Supabase-Dashboard unter
#  Project Settings → API
# ─────────────────────────────────────────────────────────────

# Projekt-URL, z. B. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Service-Role-Key. Nur serverseitig verwenden — dieser Key umgeht
# die Row Level Security und darf niemals im Browser landen.
# Deshalb ohne NEXT_PUBLIC_-Präfix.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
#  Resend — E-Mail-Benachrichtigung bei neuer Anfrage
#  https://resend.com → API Keys
# ─────────────────────────────────────────────────────────────

RESEND_API_KEY=

# Absenderadresse. Die Domain muss in Resend verifiziert sein,
# z. B. "Sägihof Therwil <noreply@saegihof-therwil.ch>"
KONTAKT_MAIL_FROM=

# Empfänger der Benachrichtigung. Mehrere Adressen mit Komma trennen.
KONTAKT_MAIL_TO=
