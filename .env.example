# ─────────────────────────────────────────────────────────────
#  Resend — E-Mail-Benachrichtigung bei neuer Anfrage
#  https://resend.com → API Keys
# ─────────────────────────────────────────────────────────────

RESEND_API_KEY=

# Absenderadresse. Die Domain muss in Resend verifiziert sein,
# z. B. "Sägihof Therwil <noreply@saegihof-therwil.ch>"
KONTAKT_MAIL_FROM=

# Empfänger der Benachrichtigung. Mehrere Adressen mit Komma trennen.
KONTAKT_MAIL_TO=

# ─────────────────────────────────────────────────────────────
#  Google Analytics 4 — Reichweitenmessung
#  https://analytics.google.com -> Verwaltung -> Datenstreams
# ─────────────────────────────────────────────────────────────

# Mess-ID des Datenstreams, Form "G-XXXXXXXXXX". Das NEXT_PUBLIC_-Präfix ist
# hier richtig: Die ID landet zwangsläufig im Browser und ist kein Geheimnis.
#
# Fehlt der Wert, wird die Messung gar nicht erst eingebunden — die Webseite
# funktioniert dann unverändert, nur ohne Statistik. In Vercel nur für
# Production setzen, damit Vorschauen nicht mitgezählt werden.
#
# Mit Wert steht das Google-Tag im Einwilligungsmodus (Consent Mode v2) immer
# im <head>. Ohne Zustimmung setzt es keine Cookies und sendet nur cookielose
# Signale; Cookies erst nach «Alle akzeptieren» in der Cookie-Leiste.
NEXT_PUBLIC_GA_ID=

# ─────────────────────────────────────────────────────────────
#  Meta-Pixel (Facebook/Instagram) — Werbeerfolgsmessung
# ─────────────────────────────────────────────────────────────

# Optional. Ohne Wert gilt die im Code hinterlegte Pixel-ID 1148014414837372.
# Geladen wird der Pixel nur im Production-Deployment und nur nach Zustimmung.
NEXT_PUBLIC_META_PIXEL_ID=

# Vercel Web Analytics braucht keine Variable: im Vercel-Projekt unter
# Analytics aktivieren, danach neu deployen.

# Search Console: optionaler Inhalt des google-site-verification-Meta-Tags.
# Bei Verifizierung der Domain über DNS wird dieser Wert nicht benötigt.
GOOGLE_SITE_VERIFICATION=
